# Ignorar todo dentro de storage
/storage/*
 
# Pero no ignorar la carpeta api-docs ni su contenido
!storage/api-docs/
!storage/api-docs/**
/.phpunit.cache
/node_modules
/public/build
/public/hot
/storage/*.key
/storage/pail
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed

